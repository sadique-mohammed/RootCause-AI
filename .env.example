# ============================================
# RootCause AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in real values.

# ---------- Target VM ----------
TARGET_HOST=192.168.64.2
TARGET_USER=ubuntu
TARGET_SSH_KEY=~/.ssh/id_rsa
# TARGET_PASSWORD=  # fallback if no SSH key
SSH_ACCEPT_UNKNOWN_HOST_KEYS=false

# ---------- Database ----------
# Using Neon Postgres (Serverless PostgreSQL 16)
# Format: postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://rootcause:rootcause@localhost:5432/rootcause_db

# ---------- AI / LLM ----------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Local LLM via Ollama (default for dev)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# LiteLLM provider routing
LITELLM_PROVIDER=ollama  # options: openai, ollama
LITELLM_TIMEOUT=30       # per-call timeout in seconds

# System Prompt (SECURITY: set the full SRE prompt here, never in source code)
# SYSTEM_PROMPT="You are a Senior Site Reliability Engineer investigating a live systems incident..."

# ---------- Reasoning Engine ----------
MAX_TOOL_ITERATIONS=15
DIAGNOSIS_TIMEOUT_SECONDS=120
MAX_OUTPUT_LENGTH=2000

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=DEBUG
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
AUTO_CREATE_DB=false

# Privileged lab controls. Keep disabled unless this API is bound to a trusted local lab.
INCIDENT_MUTATION_ENABLED=false
# INCIDENT_CONTROL_TOKEN=change-me
